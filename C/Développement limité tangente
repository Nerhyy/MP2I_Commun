///////////////////////////////////Fonctions//////////////////////////////////



//Calcule de la factorielle d'un entier n

//Entrée : un entier

//Preconditions : l'entier doit être positif ou nul

//Sortie : la factorielle de l'entier



uint fact(uint n) {

    if(n==0) {

        return 1;

    }

    if(n==1) {

        return n;

    }

    else {

        return n*fact(n-1);

    }

}


//-------------------------------------------------

//Fonction qui remplit un triangle de pascal
//pour ensuite définir en variable global k parmi n


uint** Remplit_coefb(int n) {

    uint** TriangleP = malloc(n*sizeof(uint*));



    for (int i=0; i<n; i++) {

        TriangleP[i] = malloc((i + 1) * sizeof(uint));

    }



    TriangleP[0][0] = 1;

    for (int i = 1; i < n; i++) {

        TriangleP[i][0] = 1;

        TriangleP[i][i] = 1;

        for (int j = 1; j < i; j++) {

            TriangleP[i][j] = TriangleP[i - 1][j - 1] + TriangleP[i - 1][j];

        }

    }



    return TriangleP;

}

//----------------------------------------------

//Fonction remplissant la variable global alpha
//Entrée: un entier
//Préconditions: l'entier eet positif
//Sortie : les n alphas

uint* Remplit_alpha_k(int n){
    //Initialisation
    uint* alpha = malloc(n*sizeof(uint));
    for(int m = 2; m<n; m++){
        alpha [m] = 0;
    }
    alpha[0] = 1;
    alpha[1] = 1;
    
    //calcul des alphas
    for(int i = 1; i<n; i++){
        for(int j = 0; j< i+1 ; j++){
            alpha[i+1] += coefb[i][j]*alpha[j]*alpha[i-j];
        }
        alpha[i+1] /= 2;
    }
    
    
    return alpha;

}

