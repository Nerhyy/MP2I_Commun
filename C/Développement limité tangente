}

void test_pgcd(){
    assert(pgcd(1,15) == 1);
    assert(pgcd(6,9) == 3);
    assert(pgcd(6,36) == 6);
    assert(pgcd(42,42));
    assert(pgcd(272,5040) == 16);
    assert(pgcd(2,6)==2);
}

