}

//-----------------------------------------------

//Fonction qui remplit un tableau avec les coefficients du DL de tangente

//Entrée : un entier n
//Préconditions : un entier positif correspondant à l'ordre du DL
//Sortie: un tableau avec les coef pour l'ordre n du DL de tangente


frac* Remplit_coeftan(int n){
    uint PGCD = 0;
    uint factoriel = 0; // On calcule le factoriel et le pgcd séparément pour la complexité
    frac* coeftan = malloc(n*sizeof(frac));
    for (int i = 0; i<(n+1)/2; i++){
        //Calcul du PGCD et de la factoriel
        factoriel = fact(2*i+1);
        PGCD = pgcd(alpha_k[2*i+1], factoriel);
        //Division par le PGCD (fraction irréductible)
        coeftan[i].num = ((alpha_k[2*i+1])/PGCD);
        coeftan[i].denom = (factoriel/PGCD);
    }
    return coeftan;


}

//--------------------------------------------


//Fonction affichant les fractions

//Entrée : un tableau de fractions
//Sortie : affichage des fractions 
//Post conditions: Format (xxxx/xxxx)

void affiche_frac(frac* tab, int n){
    for(int i = 0; i<n; i++){
        printf("%d/%d\n", tab[i].num, tab[i].denom);
    }
}


//--------------------------------------------------

//Fonction calculant le pgcd de 2 nombres

// Entrée : 2 entiers
// Préconditions : cette version prends que les positifs
// Sortie : un entier
// Post condition: il est le pgcd des 2 nombres en entré

uint pgcd(uint a, uint b){
    if(b==0){
        return a;
    }
    else{
    return pgcd(b, a%b);
    }
}


void affiche_DL_tan(frac* coeftan, int n){
    int deg = 1;
    if(n>1){
        printf("x + ");
        if(n>2){
            deg += 2;
            for(int i = 1; i<(n+1)/2; i++){
            printf("(%d/%d)x^%d + ", coeftan[i].num, coeftan[i].denom,deg);
            deg += 2;
            }
        }    
        printf("o(x^%d)", deg-2);
           
    }
}




